# Configure as mesmas variáveis em Netlify > Site configuration > Environment variables.
# Use SOMENTE a chave pública/publishable do Supabase. Nunca use service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA

# Alternativa para a chave pública: VITE_SUPABASE_ANON_KEY (não precisa preencher ambas).
